PORT=5000
DATABASE_URL=

# The account registered with this email becomes the site owner (set it before first sign-up).
OWNER_EMAIL=

# Required for production sessions; generate a long random value and keep it private.
# MEETHAQ_SESSION_SECRET=

# Optional Google sign-in. Add http://localhost:5000 under Authorized JavaScript origins
# and register this exact redirect URI under Authorized redirect URIs in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Optional AI assistant settings for Rafiq.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Number of reverse-proxy hops in front of the app (Render/Railway/Fly = 1). Use 0 if none.
# TRUST_PROXY=1
