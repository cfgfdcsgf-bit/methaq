PORT=5000
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# The account registered with this email becomes the site owner (set it before first sign-up).
OWNER_EMAIL=

# Required for production sessions; generate a long random value and keep it private.
# MEETHAQ_SESSION_SECRET=

# Optional Google sign-in. Add http://localhost:5000 under Authorized JavaScript origins
# and register this exact redirect URI under Authorized redirect URIs in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Optional email verification and password recovery (all three values are required to enable).
# Create a Resend API key and verify the sender domain; keep the key on the server only.
# RESEND_API_KEY=
# MAIL_FROM=Meethaq <no-reply@example.com>
# APP_URL=https://meethaq.example.com

# Optional AI assistant settings for Rafiq.
OPENAI_API_KEY=
OPENAI_MODEL=
RAFIQ_DAILY_LIMIT_PER_USER=20
RAFIQ_DAILY_LIMIT_GLOBAL=600
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# Cloudflare Workers AI on Workers Free. Use the Workers AI API token as OPENAI_API_KEY.
# OPENAI_API_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
# OPENAI_MODEL=@cf/google/gemma-4-26b-a4b-it
# Optional Tavily API key for wider web search in Rafiq.
# RAFIQ_WEB_SEARCH_KEY=

# Number of reverse-proxy hops in front of the app (Render/Railway/Fly = 1). Use 0 if none.
# TRUST_PROXY=1

# Optional Web Push. Use a private persistent directory outside publicly served files.
# One long-running Meethaq server owns this directory and runs the reminder scheduler.
# MEETHAQ_PUSH_DATA=./.work/reminders
# MEETHAQ_PUSH_CONTACT=mailto:admin@example.com
